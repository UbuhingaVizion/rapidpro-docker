# ---------------------------------------------------------------------------
# RapidPro Docker stack configuration.
#
# Copy to `.env` (gitignored) and edit:
#     cp .env.example .env
#
# Compose reads, highest precedence first:
#   1. the host environment
#   2. this .env file
#   3. defaults baked into docker-compose.yml (same as the values below)
#
# To use /etc/default/environment for the host-driven values:
#     COMPOSE_ENV_FILES=.env,/etc/default/environment docker compose up -d
# or export the file in your shell / systemd unit before running compose.
# ---------------------------------------------------------------------------

# --- host port publishing --------------------------------------------------
# nginx is the only service intended to be public. Default binds it to loopback
# so a host-level TLS proxy (certbot) / Cloudflare tunnel is the only edge and
# cannot be bypassed. Set to 0.0.0.0 only if compose nginx is the direct edge.
NGINX_BIND=127.0.0.1
NGINX_HTTP_PORT=80
# App debug ports bind to loopback by default so they are not internet-reachable.
RAPIDPRO_BIND=127.0.0.1
RAPIDPRO_HTTP_PORT=8000
MAILROOM_BIND=127.0.0.1
MAILROOM_HTTP_PORT=8090
COURIER_BIND=127.0.0.1
COURIER_HTTP_PORT=8080
# postgres/redis/elastic are on the isolated rapidpro-data network and publish
# no host ports (use `docker compose exec` for access).

# --- database --------------------------------------------------------------
POSTGRES_USER=temba
POSTGRES_DB=temba
POSTGRES_PASSWORD=tembatemba

# --- Django ----------------------------------------------------------------
# PRODUCTION: generate a long random value, e.g. `openssl rand -hex 32`.
DJANGO_SECRET_KEY=change-me
# PRODUCTION: set to your public host, e.g. app.ubuviz.com
DJANGO_ALLOWED_HOSTS=*
# PRODUCTION: https://app.ubuviz.com (drop the ngrok entry)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://app.ubuviz.com
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# PRODUCTION: https://app.ubuviz.com/media
STORAGE_URL=http://localhost/media

# --- internal service URLs (compose network) -------------------------------
REDIS_URL=redis://redis:6379/15
ELASTICSEARCH_URL=http://elastic:9200
MAILROOM_URL=http://mailroom:8090

# --- auth between RapidPro and mailroom (empty = disabled) -----------------
MAILROOM_AUTH_TOKEN=

# --- public domains used by mailroom/courier -------------------------------
# PRODUCTION: set to app.ubuviz.com (and COURIER_BASE_URL https://app.ubuviz.com)
MAILROOM_DOMAIN=host.docker.internal
MAILROOM_ATTACHMENT_DOMAIN=host.docker.internal
COURIER_DOMAIN=host.docker.internal
COURIER_BASE_URL=https://host.docker.internal
# courier runs as a non-root distroless user; /var/spool/courier isn't writable.
COURIER_SPOOL_DIR=/tmp/courier

# --- object storage (SeaweedFS S3) -----------------------------------------
S3_ACCESS_KEY=root
S3_SECRET_KEY=tembatemba
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_REGION=us-east-1

# --- log levels ------------------------------------------------------------
MAILROOM_LOG_LEVEL=info
COURIER_LOG_LEVEL=info
INDEXER_LOG_LEVEL=info
ARCHIVER_LOG_LEVEL=info
ELASTIC_LOG_LEVEL=INFO
REDIS_LOG_LEVEL=warning

# --- rp-archiver -----------------------------------------------------------
ARCHIVER_ARCHIVE_MESSAGES=true
ARCHIVER_ARCHIVE_RUNS=true
ARCHIVER_RETENTION_PERIOD=90
ARCHIVER_DELETE=false
